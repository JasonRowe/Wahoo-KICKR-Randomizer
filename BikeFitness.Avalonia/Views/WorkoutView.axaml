<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:BikeFitness.Shared.ViewModels"
             xmlns:controls="using:BikeFitness.Avalonia.Controls"
             xmlns:conv="using:BikeFitness.Avalonia.Converters"
             xmlns:material="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
             xmlns:assist="clr-namespace:Material.Styles.Assists;assembly=Material.Styles"
             xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="700"
             x:Class="BikeFitness.Avalonia.Views.WorkoutView"
             x:DataType="vm:WorkoutViewModel"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <conv:SharedColorToBrushConverter x:Key="SharedColorToBrushConverter" />
        <conv:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid RowDefinitions="Auto, *, Auto">
        <!-- Top Bar -->
        <material:ColorZone Grid.Row="0" Mode="PrimaryMid" Padding="12" assist:ShadowAssist.ShadowDepth="Depth2">
            <Grid ColumnDefinitions="*, Auto">
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <avalonia:MaterialIcon Kind="Bike" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Width="28" Height="28"/>
                    <TextBlock Text="TRAINING SESSION" Classes="Headline6" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                </StackPanel>
                
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <ToggleSwitch Content="LOG" IsChecked="{Binding IsLoggingEnabled}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Classes="Accent"/>
                    <ToggleSwitch Content="METRIC" IsChecked="{Binding IsMetric}" Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Classes="Accent"/>
                    
                    <ComboBox ItemsSource="{Binding TireSizes}" SelectedItem="{Binding SelectedTireSize}" Width="150" Theme="{StaticResource MaterialOutlineComboBox}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <Border Background="{DynamicResource SecondaryHueMidBrush}" CornerRadius="16" Padding="12,4">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <avalonia:MaterialIcon Kind="BluetoothConnected" Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryHueMidForegroundBrush}"/>
                            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource SecondaryHueMidForegroundBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </material:ColorZone>

        <!-- Main Content -->
        <Grid Grid.Row="1" ColumnDefinitions="320, *" Margin="16">
            <!-- Side Controls -->
            <StackPanel Spacing="16">
                <material:Card Padding="20" assist:ShadowAssist.ShadowDepth="Depth1">
                    <StackPanel Spacing="20">
                        <TextBlock Text="INTENSITY" Classes="Subtitle1" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding MinLabel}" Classes="Caption" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MinResistance, StringFormat={}({0:F1}%)}" Classes="Caption" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </Grid>
                            <Slider Minimum="-10" Maximum="20" Value="{Binding MinResistance}" />
                        </StackPanel>
                        
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*, Auto">
                                <TextBlock Text="{Binding MaxLabel}" Classes="Caption" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <TextBlock Grid.Column="1" Text="{Binding MaxResistance, StringFormat={}({0:F1}%)}" Classes="Caption" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </Grid>
                            <Slider Minimum="-10" Maximum="20" Value="{Binding MaxResistance}" />
                        </StackPanel>

                        <StackPanel Spacing="8">
                            <TextBlock Text="WORKOUT MODE" Classes="Caption" Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            <ComboBox SelectedIndex="{Binding SelectedModeIndex}" HorizontalAlignment="Stretch" Theme="{StaticResource MaterialOutlineComboBox}">
                                <ComboBoxItem>Random</ComboBoxItem>
                                <ComboBoxItem>Hilly</ComboBoxItem>
                                <ComboBoxItem>Mountain</ComboBoxItem>
                                <ComboBoxItem>Pyramid</ComboBoxItem>
                            </ComboBox>
                        </StackPanel>

                        <material:Card Background="{DynamicResource MaterialDesignCardBackground}" Padding="8" assist:ShadowAssist.ShadowDepth="Depth0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12">
                                <Button Content="-" Command="{Binding DecreaseIntervalCommand}" Width="40" Height="40" 
                                        Classes="Flat" CornerRadius="20"/>
                                <StackPanel VerticalAlignment="Center" Width="80">
                                    <TextBlock Text="INTERVAL" Classes="Caption" HorizontalAlignment="Center"/>
                                    <TextBlock Text="{Binding IntervalSeconds, StringFormat={}{0}s}" Classes="Headline6" HorizontalAlignment="Center"/>
                                </StackPanel>
                                <Button Content="+" Command="{Binding IncreaseIntervalCommand}" Width="40" Height="40" 
                                        Classes="Flat" CornerRadius="20"/>
                            </StackPanel>
                        </material:Card>

                        <Button Content="START WORKOUT" Command="{Binding StartCommand}" Width="240" Height="48" 
                                Classes="Primary Raised" CornerRadius="24" FontWeight="Bold"/>
                        
                        <Button Content="STOP WORKOUT" Command="{Binding StopCommand}" Width="240" Height="48" 
                                Classes="Accent Raised" CornerRadius="24" FontWeight="Bold"/>

                        <!-- Pacer (POC). Collapsed and off by default: with it closed this ride is exactly the
                             ride you had before. Kept in step with the WPF app's panel. -->
                        <Expander Header="PACER (beta)" IsExpanded="False" Margin="0,8,0,0">
                            <StackPanel Spacing="6" Margin="0,8,0,0">
                                <CheckBox x:Name="ChkPacerEnabled" Content="Race a virtual pacer" IsChecked="False"
                                          Checked="ChkPacerEnabled_Changed" Unchecked="ChkPacerEnabled_Changed"/>
                                <TextBlock TextWrapping="Wrap" Classes="Caption" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Text="A synthetic rival that holds a gap ahead of you and reacts to how you ride. It only moves itself — your resistance is never touched."/>

                                <CheckBox x:Name="ChkPacerRideAlong" Content="Ride along: sit with me, then attack" IsChecked="False"
                                          Checked="PacerCheck_Changed" Unchecked="PacerCheck_Changed"/>
                                <TextBlock TextWrapping="Wrap" Classes="Caption" Foreground="{DynamicResource MaterialDesignBodyLight}"
                                           Text="He rides level with you instead of holding a gap up the road, and takes off now and then so you have to chase him back. Ticking this switches the pacer on."/>

                                <StackPanel x:Name="PanelPacerRideAlong" Spacing="6" Margin="16,4,0,0" IsVisible="False">
                                    <Grid ColumnDefinitions="130, 40, *">
                                        <TextBlock Grid.Column="0" Text="Alongside (m):" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding #SliderPacerAlongside.Value, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Slider Grid.Column="2" x:Name="SliderPacerAlongside" Minimum="1" Maximum="12" Value="4"
                                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="130, 40, *">
                                        <TextBlock Grid.Column="0" Text="Attack (m):" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding #SliderPacerAttackPush.Value, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Slider Grid.Column="2" x:Name="SliderPacerAttackPush" Minimum="2" Maximum="20" Value="8"
                                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="130, 40, *">
                                        <TextBlock Grid.Column="0" Text="Attack every (s):" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding #SliderPacerAttackInterval.Value, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Slider Grid.Column="2" x:Name="SliderPacerAttackInterval" Minimum="45" Maximum="300" Value="120"
                                                TickFrequency="5" IsSnapToTickEnabled="True"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="130, 40, *">
                                        <TextBlock Grid.Column="0" Text="Attack length (s):" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding #SliderPacerAttackLength.Value, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Slider Grid.Column="2" x:Name="SliderPacerAttackLength" Minimum="5" Maximum="30" Value="12"
                                                TickFrequency="1" IsSnapToTickEnabled="True"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="130, 40, *">
                                        <TextBlock Grid.Column="0" Text="Recover (x):" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding #SliderPacerRecover.Value, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Slider Grid.Column="2" x:Name="SliderPacerRecover" Minimum="0.60" Maximum="0.95" Value="0.80"
                                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="130, 40, *">
                                        <TextBlock Grid.Column="0" Text="Catch line (m):" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding #SliderPacerCatch.Value, StringFormat='{}{0:F1}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Slider Grid.Column="2" x:Name="SliderPacerCatch" Minimum="2" Maximum="15" Value="5"
                                                TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                                    </Grid>
                                </StackPanel>

                                <Grid ColumnDefinitions="130, 40, *" Margin="0,4,0,0">
                                    <TextBlock Grid.Column="0" Text="Strength (W/kg):" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding #SliderPacerStrength.Value, StringFormat='{}{0:F1}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <Slider Grid.Column="2" x:Name="SliderPacerStrength" Minimum="1.5" Maximum="4.0" Value="2.5"
                                            TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                                </Grid>

                                <Grid ColumnDefinitions="130, 40, *">
                                    <TextBlock Grid.Column="0" Text="Gap (m):" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding #SliderPacerGap.Value, StringFormat='{}{0:F0}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <Slider Grid.Column="2" x:Name="SliderPacerGap" Minimum="10" Maximum="40" Value="25"
                                            TickFrequency="1" IsSnapToTickEnabled="True"/>
                                </Grid>

                                <Grid ColumnDefinitions="130, 40, *">
                                    <TextBlock Grid.Column="0" Text="Elasticity:" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding #SliderPacerElasticity.Value, StringFormat='{}{0:F2}'}" VerticalAlignment="Center" TextAlignment="Right"/>
                                    <Slider Grid.Column="2" x:Name="SliderPacerElasticity" Minimum="0.10" Maximum="0.80" Value="0.35"
                                            TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                                </Grid>

                                <CheckBox x:Name="ChkPacerMercy" Content="Mercy rule (ease off when I fade)" IsChecked="True"
                                          Checked="PacerCheck_Changed" Unchecked="PacerCheck_Changed"/>
                                <CheckBox x:Name="ChkPacerStrip" Content="Gap strip" IsChecked="True"
                                          Checked="PacerCheck_Changed" Unchecked="PacerCheck_Changed"/>

                                <TextBlock x:Name="TxtPacerReadout" TextWrapping="Wrap" Classes="Caption"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                <Button x:Name="BtnPacerReset" Content="Reset duel" Width="120" HorizontalAlignment="Left"
                                        Click="BtnPacerReset_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </material:Card>
            </StackPanel>

            <!-- Simulation -->
            <material:Card Grid.Column="1" Margin="16,0,0,0" Padding="0" ClipToBounds="True" Background="Black">
                <Grid>
                    <controls:SimulationCanvas x:Name="SimCanvas"
                                              SpeedKph="{Binding CurrentSpeedKph}" 
                                              GradePercent="{Binding CurrentGradePercent}"
                                              SyncedDistanceMeters="{Binding CurrentDistanceMeters}"/>

                    <!-- HUD -->
                    <material:Card VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24" Padding="16" 
                                   Background="#CC212121" assist:ShadowAssist.ShadowDepth="Depth2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <avalonia:MaterialIcon Kind="SlopeUphill" Width="32" Height="32" Foreground="Silver" VerticalAlignment="Center"/>
                            <StackPanel>
                                <TextBlock Text="GRADE" Classes="Caption" Foreground="Silver" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResistancePercent, StringFormat={}{0:F1}%}" Classes="Headline2" FontWeight="Black" 
                                         Foreground="{Binding ResistanceColor, Converter={StaticResource SharedColorToBrushConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </material:Card>

                    <!-- Pacer HUD (POC). Hidden unless the pacer is on. Top-right so it never overlaps the grade
                         badge, mirroring the WPF app. -->
                    <material:Card x:Name="CardPacerHud" IsVisible="False"
                                   VerticalAlignment="Top" HorizontalAlignment="Right" Margin="24" Padding="16"
                                   Background="#CC212121" assist:ShadowAssist.ShadowDepth="Depth2">
                        <StackPanel Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <avalonia:MaterialIcon Kind="Bike" Width="26" Height="26" Foreground="Silver" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtPacerState" Classes="Headline4" FontWeight="Bold" Foreground="MediumSeaGreen" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtPacerGap" FontFamily="Consolas" FontSize="20" Foreground="White"/>
                            <TextBlock x:Name="TxtPacerDelta" FontFamily="Consolas" FontSize="20" Foreground="White"/>
                            <TextBlock x:Name="TxtPacerVerdict" FontFamily="Consolas" FontSize="14" Foreground="Silver"/>
                            <TextBlock x:Name="TxtPacerWatts" FontFamily="Consolas" FontSize="12" Foreground="Silver"/>
                        </StackPanel>
                    </material:Card>

                    <Grid x:Name="TelemetryBar" VerticalAlignment="Bottom" ColumnDefinitions="*, *, *" Margin="16">
                        <material:Card Grid.Column="0" Margin="8" Padding="16" Background="#CC212121">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="POWER" Classes="Caption" Foreground="Silver" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PowerText}" Classes="Headline3" FontWeight="Black" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                        </material:Card>
                        <material:Card Grid.Column="1" Margin="8" Padding="16" Background="#CC212121">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding SpeedLabel}" Classes="Caption" Foreground="Silver" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SpeedText}" Classes="Headline3" FontWeight="Black" Foreground="#4CAF50"/>
                            </StackPanel>
                        </material:Card>
                        <material:Card Grid.Column="2" Margin="8" Padding="16" Background="#CC212121">
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding DistanceLabel}" Classes="Caption" Foreground="Silver" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DistanceText}" Classes="Headline3" FontWeight="Black" Foreground="White"/>
                            </StackPanel>
                        </material:Card>
                    </Grid>

                    <!-- Workout Complete Overlay -->
                    <material:Card IsVisible="{Binding ShowPostWorkoutOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="#DD000000" Padding="32"
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            MaxWidth="550" assist:ShadowAssist.ShadowDepth="Depth5">
                        <StackPanel Spacing="16">
                            <TextBlock Text="WORKOUT COMPLETE!" Classes="Headline4" FontWeight="Black" HorizontalAlignment="Center" Foreground="White"/>
                            <TextBlock Text="Great ride! How would you like to save your progress?" Classes="Subtitle1" Opacity="0.8" HorizontalAlignment="Center" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"/>
                            
                            <Grid ColumnDefinitions="*, *" Margin="0,16,0,0">
                                <Button Grid.Column="0" Command="{Binding SaveFitCommand}" Margin="8" Height="64"
                                        Classes="Primary Raised" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <avalonia:MaterialIcon Kind="FileDownload" Width="24" Height="24"/>
                                        <TextBlock Text="DOWNLOAD" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding UploadStravaCommand}" Margin="8" Height="64"
                                        Background="#FC4C02" Foreground="White" Classes="Raised" CornerRadius="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <avalonia:MaterialIcon Kind="CloudUpload" Width="24" Height="24"/>
                                        <TextBlock Text="STRAVA" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Content="DISMISS" Command="{Binding DismissPostWorkoutCommand}" 
                                    HorizontalAlignment="Center" Classes="Flat" Foreground="Silver"/>
                        </StackPanel>
                    </material:Card>
                </Grid>
            </material:Card>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="{DynamicResource MaterialDesignCardBackground}" Padding="12,4" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
            <TextBlock Text="{Binding Log}" Classes="Caption" Opacity="0.6"/>
        </Border>
    </Grid>
</UserControl>
