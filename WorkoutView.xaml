<UserControl x:Class="BikeFitnessApp.WorkoutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:BikeFitnessApp.Converters"
             xmlns:shared="clr-namespace:BikeFitnessApp"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             TextElement.Foreground="{DynamicResource MaterialDesignBody}"
             TextElement.FontWeight="Regular"
             TextElement.FontSize="14"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="Auto"
             Background="{DynamicResource MaterialDesignPaper}"
             FontFamily="{materialDesign:MaterialDesignFont}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:SharedColorToBrushConverter x:Key="SharedColorToBrushConverter" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Bar -->
        <materialDesign:ColorZone Mode="PrimaryMid" Padding="12" materialDesign:ElevationAssist.Elevation="Dp4">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="BikeFast" Width="28" Height="28" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <TextBlock Text="TRAINING SESSION" Style="{DynamicResource MaterialDesignHeadline6TextBlock}" VerticalAlignment="Center" FontWeight="Bold"/>
                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Menu Background="Transparent" TextElement.Foreground="{DynamicResource PrimaryHueMidForegroundBrush}" Margin="0,0,16,0">
                        <MenuItem Header="SETTINGS" Height="32">
                            <MenuItem x:Name="MenuEnableLogging" Header="Enable Logging" IsCheckable="True" IsChecked="{Binding IsLoggingEnabled}" Foreground="Black"/>
                            <Separator/>
                            <MenuItem Header="Units" Foreground="Black">
                                <MenuItem Header="Metric (KPH)" IsCheckable="True" IsChecked="{Binding IsMetric}" Foreground="Black"/>
                            </MenuItem>
                            <MenuItem Header="Tire Size" Foreground="Black" ItemsSource="{Binding TireSizes}">
                                <MenuItem.ItemContainerStyle>
                                    <Style TargetType="MenuItem" BasedOn="{StaticResource MaterialDesignMenuItem}">
                                        <Setter Property="Header" Value="{Binding Name}"/>
                                        <Setter Property="IsCheckable" Value="True"/>
                                        <Setter Property="IsChecked">
                                            <Setter.Value>
                                                <MultiBinding Converter="{x:Static converters:EqualityConverter.Instance}">
                                                    <Binding Path="DataContext.SelectedTireSize" RelativeSource="{RelativeSource AncestorType=MenuItem, AncestorLevel=2}"/>
                                                    <Binding Path="."/>
                                                </MultiBinding>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Command" Value="{Binding DataContext.SelectTireSizeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        <Setter Property="CommandParameter" Value="{Binding .}"/>
                                    </Style>
                                </MenuItem.ItemContainerStyle>
                            </MenuItem>
                        </MenuItem>
                    </Menu>
                    <materialDesign:Chip x:Name="TxtStatus" Content="{Binding Status}" 
                          Background="#4CAF50" Foreground="White" IconBackground="#388E3C">
                        <materialDesign:Chip.Icon>
                            <materialDesign:PackIcon Kind="BluetoothConnected" />
                        </materialDesign:Chip.Icon>
                    </materialDesign:Chip>
                </StackPanel>
            </Grid>
        </materialDesign:ColorZone>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Controls Side -->
            <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <materialDesign:Card Padding="16" materialDesign:ElevationAssist.Elevation="Dp2" UniformCornerRadius="16">
                    <StackPanel>
                        <TextBlock Text="INTENSITY RANGE" Style="{DynamicResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MinLabel}" Style="{DynamicResource MaterialDesignOverlineTextBlock}"/>
                            <TextBlock Text="{Binding MinResistance, StringFormat={}({0}%)}" 
                                       Style="{DynamicResource MaterialDesignOverlineTextBlock}" Margin="8,0,0,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                        <Slider x:Name="SliderMin" Minimum="-10" Maximum="20" Value="{Binding MinResistance}" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Style="{DynamicResource MaterialDesignSlider}" Margin="0,0,0,16"/>
                        
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding MaxLabel}" Style="{DynamicResource MaterialDesignOverlineTextBlock}"/>
                            <TextBlock Text="{Binding MaxResistance, StringFormat={}({0}%)}" 
                                       Style="{DynamicResource MaterialDesignOverlineTextBlock}" Margin="8,0,0,0" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                        </StackPanel>
                        <Slider x:Name="SliderMax" Minimum="-10" Maximum="20" Value="{Binding MaxResistance}" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                Style="{DynamicResource MaterialDesignSlider}" Margin="0,0,0,16"/>

                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="WORKOUT MODE" Style="{DynamicResource MaterialDesignOverlineTextBlock}"/>
                            <ComboBox x:Name="ComboWorkoutMode" SelectedIndex="{Binding SelectedModeIndex}" Style="{DynamicResource MaterialDesignOutlinedComboBox}" Margin="0,8,0,0">
                                <ComboBoxItem Content="Random 🎲"/>
                                <ComboBoxItem Content="Hilly ⛰️"/>
                                <ComboBoxItem Content="Mountain Climb 🏔️"/>
                                <ComboBoxItem Content="Pyramid Mode 📈"/>
                            </ComboBox>
                        </StackPanel>

                        <materialDesign:ColorZone Mode="Light" Padding="8" CornerRadius="8" materialDesign:ElevationAssist.Elevation="Dp0">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{DynamicResource MaterialDesignToolButton}" Command="{Binding DecreaseIntervalCommand}" Margin="0,0,4,0">
                                    <materialDesign:PackIcon Kind="ChevronDown" />
                                </Button>
                                
                                <materialDesign:PackIcon Kind="Timer" Margin="0,0,4,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtInterval" Text="{Binding IntervalText}" VerticalAlignment="Center" FontWeight="SemiBold" Width="70" TextAlignment="Center"/>
                                
                                <Button Style="{DynamicResource MaterialDesignToolButton}" Command="{Binding IncreaseIntervalCommand}" Margin="4,0,0,0">
                                    <materialDesign:PackIcon Kind="ChevronUp" />
                                </Button>
                            </StackPanel>
                        </materialDesign:ColorZone>

                        <!-- Pacer (POC 2 wiring). Collapsed and off by default: with it closed, this ride is
                             exactly the ride you had before. -->
                        <Expander x:Name="ExpanderPacer" Header="PACER (beta)" IsExpanded="False" Margin="0,16,0,0">
                            <StackPanel Margin="0,8,0,0">
                                <CheckBox x:Name="ChkPacerEnabled" Content="Race a virtual pacer" IsChecked="False"
                                          Checked="ChkPacerEnabled_Changed" Unchecked="ChkPacerEnabled_Changed"/>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,10"
                                           Text="A synthetic rival that holds a gap ahead of you and reacts to how you ride. It only moves itself — your resistance is never touched."/>

                                <CheckBox x:Name="ChkPacerRideAlong" Content="Ride along: sit with me, then attack" IsChecked="False"
                                          Checked="PacerCheck_Changed" Unchecked="PacerCheck_Changed"/>
                                <TextBlock TextWrapping="Wrap" Opacity="0.7" Margin="0,4,0,0"
                                           Text="He rides level with you instead of holding a gap up the road, and takes off now and then so you have to chase him back. Ticking this switches the pacer on."/>

                                <StackPanel x:Name="PanelPacerRideAlong" Margin="16,6,0,0" Visibility="Collapsed">
                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Alongside (m):" Width="130" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=SliderPacerAlongside, Path=Value, StringFormat=F0}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderPacerAlongside" Minimum="1" Maximum="12" Value="4" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Attack (m):" Width="130" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=SliderPacerAttackPush, Path=Value, StringFormat=F0}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderPacerAttackPush" Minimum="2" Maximum="20" Value="8" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Attack every (s):" Width="130" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=SliderPacerAttackInterval, Path=Value, StringFormat=F0}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderPacerAttackInterval" Minimum="45" Maximum="300" Value="120" TickFrequency="5" IsSnapToTickEnabled="True"
                                                Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Attack length (s):" Width="130" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=SliderPacerAttackLength, Path=Value, StringFormat=F0}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderPacerAttackLength" Minimum="5" Maximum="30" Value="12" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Recover (x):" Width="130" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=SliderPacerRecover, Path=Value, StringFormat=F2}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderPacerRecover" Minimum="0.60" Maximum="0.95" Value="0.80" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                                Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                    </DockPanel>

                                    <DockPanel Margin="0,3">
                                        <TextBlock Text="Catch line (m):" Width="130" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ElementName=SliderPacerCatch, Path=Value, StringFormat=F1}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                        <Slider x:Name="SliderPacerCatch" Minimum="2" Maximum="15" Value="5" TickFrequency="0.5" IsSnapToTickEnabled="True"
                                                Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                    </DockPanel>
                                </StackPanel>

                                <DockPanel Margin="0,3">
                                    <TextBlock Text="Strength (W/kg):" Width="130" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=SliderPacerStrength, Path=Value, StringFormat=F1}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderPacerStrength" Minimum="1.5" Maximum="4.0" Value="2.5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                            Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                </DockPanel>

                                <DockPanel Margin="0,3">
                                    <TextBlock Text="Gap (m):" Width="130" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=SliderPacerGap, Path=Value, StringFormat=F0}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderPacerGap" Minimum="10" Maximum="40" Value="25" TickFrequency="1" IsSnapToTickEnabled="True"
                                            Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                </DockPanel>

                                <DockPanel Margin="0,3">
                                    <TextBlock Text="Elasticity:" Width="130" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=SliderPacerElasticity, Path=Value, StringFormat=F2}" Width="40" TextAlignment="Right" VerticalAlignment="Center"/>
                                    <Slider x:Name="SliderPacerElasticity" Minimum="0.10" Maximum="0.80" Value="0.35" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                            Style="{DynamicResource MaterialDesignSlider}" ValueChanged="PacerSlider_Changed"/>
                                </DockPanel>

                                <CheckBox x:Name="ChkPacerMercy" Content="Mercy rule (ease off when I fade)" IsChecked="True" Margin="0,10,0,0"
                                          Checked="PacerCheck_Changed" Unchecked="PacerCheck_Changed"/>
                                <CheckBox x:Name="ChkPacerStrip" Content="Gap strip" IsChecked="True"
                                          Checked="PacerCheck_Changed" Unchecked="PacerCheck_Changed"/>

                                <TextBlock x:Name="TxtPacerReadout" FontFamily="Consolas" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <Button x:Name="BtnPacerReset" Content="Reset duel" Width="120" HorizontalAlignment="Left" Margin="0,10,0,0"
                                        Style="{DynamicResource MaterialDesignOutlinedButton}" Click="BtnPacerReset_Click"/>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </materialDesign:Card>

                <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="0,16,0,0">
                    <Button x:Name="BtnStart" Content="START SESSION" Command="{Binding StartCommand}" 
                            Style="{DynamicResource MaterialDesignRaisedButton}" 
                            Background="#4CAF50" BorderBrush="#4CAF50"
                            Width="200" Height="45" materialDesign:ButtonAssist.CornerRadius="22" Margin="0,0,0,12">
                    </Button>
                    <Button x:Name="BtnStop" Content="STOP SESSION" Command="{Binding StopCommand}" 
                            Style="{DynamicResource MaterialDesignRaisedButton}" 
                            Background="#F44336" BorderBrush="#F44336"
                            Width="200" Height="45" materialDesign:ButtonAssist.CornerRadius="22">
                    </Button>
                </StackPanel>
            </StackPanel>

            <!-- Display Side -->
            <materialDesign:Card Grid.Column="1" Margin="4,0,0,0" UniformCornerRadius="16" Background="#1A1A1A">
                <Grid>
                    <!-- Game Canvas -->
                    <shared:SimulationCanvas x:Name="SimCanvas"
                                           SpeedKph="{Binding CurrentSpeedKph}"
                                           GradePercent="{Binding CurrentGradePercent}"
                                           SyncedDistanceMeters="{Binding CurrentDistanceMeters}"
                                           Opacity="1.0"/>

                    <!-- Pacer HUD (POC 2). Collapsed unless the pacer is switched on, so a normal ride is
                         visually unchanged. Top-right so it never overlaps the grade badge. -->
                    <materialDesign:Card x:Name="CardPacerHud" Visibility="Collapsed"
                                         VerticalAlignment="Top" HorizontalAlignment="Right" Margin="24"
                                         Background="#E6212121" UniformCornerRadius="12" Padding="16"
                                         materialDesign:ElevationAssist.Elevation="Dp6">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Bike" Width="26" Height="26" Foreground="Silver"
                                                         VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBlock x:Name="TxtPacerState" FontSize="22" FontWeight="Bold"
                                           Foreground="MediumSeaGreen" VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock x:Name="TxtPacerGap" FontFamily="Consolas" FontSize="20" Foreground="White" Margin="0,8,0,0"/>
                            <TextBlock x:Name="TxtPacerDelta" FontFamily="Consolas" FontSize="20" Foreground="White"/>
                            <TextBlock x:Name="TxtPacerVerdict" FontFamily="Consolas" FontSize="14" Foreground="Silver" Margin="0,6,0,0"/>
                            <TextBlock x:Name="TxtPacerWatts" FontFamily="Consolas" FontSize="12" Foreground="Silver" Margin="0,6,0,0"/>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- HUD: Top Left Grade Badge -->
                    <materialDesign:Card VerticalAlignment="Top" HorizontalAlignment="Left" Margin="24" 
                                       Background="#E6212121" UniformCornerRadius="12" Padding="16"
                                       materialDesign:ElevationAssist.Elevation="Dp6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="SlopeUphill" Width="32" Height="32" Foreground="Silver" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel>
                                <TextBlock Text="GRADE" Style="{StaticResource MaterialDesignOverlineTextBlock}" Foreground="Silver" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ResistancePercent, StringFormat={}{0:F1}%}" FontSize="48" FontWeight="Black" Foreground="{Binding ResistanceColor, Converter={StaticResource SharedColorToBrushConverter}}"/>
                            </StackPanel>
                        </StackPanel>
                    </materialDesign:Card>

                    <!-- HUD: Bottom Telemetry Bar -->
                    <Grid x:Name="TelemetryBar" VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Margin="16,0,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Power Panel -->
                        <materialDesign:Card Grid.Column="0" Margin="8" Background="#E6212121" UniformCornerRadius="16" Padding="12" materialDesign:ElevationAssist.Elevation="Dp4">
                            <StackPanel>
                                <TextBlock Text="POWER (WATTS)" Style="{StaticResource MaterialDesignOverlineTextBlock}" Foreground="Silver" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding PowerText}" FontSize="72" FontWeight="Black" Foreground="#2196F3" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="10" Color="#2196F3" Opacity="0.3" ShadowDepth="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Speed Panel -->
                        <materialDesign:Card Grid.Column="1" Margin="8" Background="#E6212121" UniformCornerRadius="16" Padding="12" materialDesign:ElevationAssist.Elevation="Dp4">
                            <StackPanel>
                                <TextBlock Text="{Binding SpeedLabel}" Style="{StaticResource MaterialDesignOverlineTextBlock}" Foreground="Silver" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding SpeedText}" FontSize="72" FontWeight="Black" Foreground="#4CAF50" HorizontalAlignment="Center">
                                    <TextBlock.Effect>
                                        <DropShadowEffect BlurRadius="10" Color="#4CAF50" Opacity="0.3" ShadowDepth="0"/>
                                    </TextBlock.Effect>
                                </TextBlock>
                            </StackPanel>
                        </materialDesign:Card>

                        <!-- Distance Panel -->
                        <materialDesign:Card Grid.Column="2" Margin="8" Background="#E6212121" UniformCornerRadius="16" Padding="12" materialDesign:ElevationAssist.Elevation="Dp4">
                            <StackPanel>
                                <TextBlock Text="{Binding DistanceLabel}" Style="{StaticResource MaterialDesignOverlineTextBlock}" Foreground="Silver" HorizontalAlignment="Center" FontWeight="Bold"/>
                                <TextBlock Text="{Binding DistanceText}" FontSize="72" FontWeight="Black" Foreground="White" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </materialDesign:Card>
                    </Grid>

                    <!-- Workout Complete Overlay -->
                    <materialDesign:Card VerticalAlignment="Center" HorizontalAlignment="Center" 
                                       Visibility="{Binding ShowPostWorkoutOptions, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       Background="#CC000000" UniformCornerRadius="24" Padding="32"
                                       materialDesign:ElevationAssist.Elevation="Dp24"
                                       MaxWidth="500">
                        <StackPanel>
                            <materialDesign:PackIcon Kind="CheckCircleOutline" Width="64" Height="64" Foreground="#4CAF50" HorizontalAlignment="Center" Margin="0,0,0,16"/>
                            <TextBlock Text="WORKOUT COMPLETE!" Style="{DynamicResource MaterialDesignHeadline4TextBlock}" HorizontalAlignment="Center" FontWeight="Black" Margin="0,0,0,8"/>
                            <TextBlock Text="Great ride! How would you like to save your progress?" Style="{DynamicResource MaterialDesignSubtitle1TextBlock}" Opacity="0.8" HorizontalAlignment="Center" Margin="0,0,0,32" TextAlignment="Center"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Button Grid.Column="0" Command="{Binding SaveFitCommand}" Margin="8" Height="60"
                                        Style="{DynamicResource MaterialDesignRaisedButton}" Background="#2196F3" BorderBrush="#2196F3"
                                        materialDesign:ButtonAssist.CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="Download" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="DOWNLOAD .FIT" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>

                                <Button Grid.Column="1" Command="{Binding UploadStravaCommand}" Margin="8" Height="60"
                                        Style="{DynamicResource MaterialDesignRaisedButton}" Background="#FC4C02" BorderBrush="#FC4C02"
                                        materialDesign:ButtonAssist.CornerRadius="12">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="CloudUpload" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="STRAVA UPLOAD" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Button Content="DISMISS" Margin="0,16,0,0" HorizontalAlignment="Center"
                                    Style="{DynamicResource MaterialDesignFlatButton}"
                                    Click="BtnDismiss_Click"
                                    Visibility="{Binding ShowPostWorkoutOptions, Converter={StaticResource BooleanToVisibilityConverter}}">
                            </Button>
                        </StackPanel>
                    </materialDesign:Card>
                </Grid>
            </materialDesign:Card>
        </Grid>

        <!-- Bottom Status -->
        <StatusBar Grid.Row="2" Background="Transparent" Margin="8,0">
            <StatusBarItem>
                <TextBlock x:Name="TxtLog" Text="{Binding Log}" 
                           Style="{DynamicResource MaterialDesignCaptionTextBlock}" 
                           Foreground="Gray" Opacity="0.5" FontSize="10"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</UserControl>