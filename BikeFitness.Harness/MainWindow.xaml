<Window x:Class="BikeFitness.Harness.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BikeFitness.Harness"
        xmlns:shared="clr-namespace:BikeFitnessApp;assembly=BikeFitnessApp"
        mc:Ignorable="d" 

        Title="Bike Fitness Harness - Pedal Cycle Spike" Height="920" Width="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: Canvas -->
        <Border Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="10">
            <shared:SimulationCanvas x:Name="SimCanvas" 
                                    ClipToBounds="True"
                                    SpeedKph="{Binding ElementName=SliderSpeed, Path=Value}"
                                    GradePercent="{Binding ElementName=SliderGrade, Path=Value}"/>
        </Border>

        <!-- Row 1: Controls -->
        <Border Grid.Row="1" Background="#EEEEEE" Padding="16">
            <ScrollViewer MaxHeight="460" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock FontWeight="Bold" Margin="0,0,0,8">Drive</TextBlock>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Speed (kph):" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderSpeed, Path=Value, StringFormat=F1}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderSpeed" Minimum="0" Maximum="60" Value="25" TickFrequency="1" IsSnapToTickEnabled="True"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Grade (%):" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderGrade, Path=Value, StringFormat=F1}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderGrade" Minimum="-10" Maximum="20" Value="0" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <CheckBox x:Name="ChkAutoDrive" Content="Auto-drive (sinusoidal speed/grade)" Width="300" VerticalAlignment="Center"
                                  Checked="ChkAutoDrive_Changed" Unchecked="ChkAutoDrive_Changed"/>
                    </DockPanel>

                    <Separator Margin="0,10"/>

                    <TextBlock FontWeight="Bold" Margin="0,0,0,8">Pedal cycle (prototype sheet)</TextBlock>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Metres/rev (D):" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderD, Path=Value, StringFormat=F1}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderD" Minimum="4" Maximum="9" Value="6.5" TickFrequency="0.1"
                                ValueChanged="SliderD_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <CheckBox x:Name="ChkManualFrame" Content="Manual frame" Width="130" VerticalAlignment="Center"
                                  Checked="ChkManualFrame_Changed" Unchecked="ChkManualFrame_Changed"/>
                        <TextBlock Text="Frame:" Width="40" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderFrame, Path=Value}" Width="24" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderFrame" Minimum="0" Maximum="11" Value="0" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="SliderFrame_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="130,0,0,3">
                        <Button x:Name="BtnFramePrev" Content="&#9664; step" Width="72" Margin="0,0,6,0" Click="BtnFramePrev_Click"/>
                        <Button x:Name="BtnFrameNext" Content="step &#9654;" Width="72" Click="BtnFrameNext_Click"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Seam mode:" Width="130" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbSeam" Width="220" SelectionChanged="CmbSeam_Changed">
                            <ComboBoxItem Content="Straight (12-frame loop)" IsSelected="True"/>
                            <ComboBoxItem Content="Cross-fade (~80 ms at wrap)"/>
                            <ComboBoxItem Content="Drop last frame (11-frame loop)"/>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Temporal blend:" Width="130" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbBlend" Width="220" SelectionChanged="CmbBlend_Changed">
                            <ComboBoxItem Content="Off" IsSelected="True"/>
                            <ComboBoxItem Content="20 %"/>
                            <ComboBoxItem Content="30 %"/>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Draw scale:" Width="130" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbScale" Width="220" SelectionChanged="CmbScale_Changed">
                            <ComboBoxItem Content="In-app (150 px)" IsSelected="True"/>
                            <ComboBoxItem Content="Native (290 px)"/>
                        </ComboBox>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <CheckBox x:Name="ChkWheelSpin" Content="Code wheel-spin overlay" Width="180" VerticalAlignment="Center"
                                  Checked="ChkWheelSpin_Changed" Unchecked="ChkWheelSpin_Changed"/>
                        <CheckBox x:Name="ChkHubMarker" Content="Hub markers" Width="130" VerticalAlignment="Center"
                                  Checked="ChkHubMarker_Changed" Unchecked="ChkHubMarker_Changed"/>
                    </DockPanel>

                    <Separator Margin="0,10"/>

                    <!-- POC 1: Ghost racer. Everything here is off by default. -->
                    <TextBlock FontWeight="Bold" Margin="0,0,0,8">Second rider — ghost (POC 1)</TextBlock>

                    <DockPanel Margin="0,3">
                        <CheckBox x:Name="ChkGhost" Content="Enable ghost" Width="130" VerticalAlignment="Center"
                                  Checked="ChkGhost_Changed" Unchecked="ChkGhost_Changed"/>
                        <TextBlock x:Name="TxtGhostGap" Width="150" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtGhostDelta" Width="150" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtGhostSpeed" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Profile:" Width="130" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbGhostProfile" Width="240" SelectionChanged="CmbGhostProfile_Changed">
                            <ComboBoxItem Content="Mirror my effort (auto-drive)" IsSelected="True"/>
                            <ComboBoxItem Content="Canned ride (synthetic 20 min)"/>
                            <ComboBoxItem Content="Load Workout_*.json…"/>
                        </ComboBox>
                    </DockPanel>

                    <TextBlock x:Name="TxtGhostProfile" Margin="130,0,0,3" FontStyle="Italic" TextWrapping="Wrap"/>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Ghost effort (%):" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderGhostEffort, Path=Value, StringFormat=F0}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderGhostEffort" Minimum="85" Maximum="110" Value="100" TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="SliderGhostEffort_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Ghost opacity (%):" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderGhostOpacity, Path=Value, StringFormat=F0}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderGhostOpacity" Minimum="20" Maximum="70" Value="40" TickFrequency="5" IsSnapToTickEnabled="True"
                                ValueChanged="SliderGhostOpacity_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="130,0,0,3">
                        <Button x:Name="BtnGhostHeadStart" Content="Give me head start" Width="140" Margin="0,0,6,0" Click="BtnGhostHeadStart_Click"/>
                        <Button x:Name="BtnGhostReset" Content="Reset ghost" Width="110" Click="BtnGhostReset_Click"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <CheckBox x:Name="ChkGhostMarker" Content="Off-screen marker" Width="180" VerticalAlignment="Center" IsChecked="True"
                                  Checked="ChkGhostMarker_Changed" Unchecked="ChkGhostMarker_Changed"/>
                        <CheckBox x:Name="ChkGhostHud" Content="HUD (gap + delta)" Width="180" VerticalAlignment="Center" IsChecked="True"
                                  Checked="ChkGhostHud_Changed" Unchecked="ChkGhostHud_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <CheckBox x:Name="ChkPerfHud" Content="Perf HUD" Width="130" VerticalAlignment="Center"
                                  Checked="ChkPerfHud_Changed" Unchecked="ChkPerfHud_Changed"/>
                        <TextBlock x:Name="TxtPerf" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </DockPanel>

                    <Separator Margin="0,10"/>

                    <!-- POC 2: rubber-band pacer. Mutually exclusive with the ghost. -->
                    <TextBlock FontWeight="Bold" Margin="0,0,0,8">Second rider — pacer (POC 2)</TextBlock>

                    <DockPanel Margin="0,3">
                        <CheckBox x:Name="ChkPacer" Content="Enable pacer" Width="130" VerticalAlignment="Center"
                                  Checked="ChkPacer_Changed" Unchecked="ChkPacer_Changed"/>
                        <TextBlock x:Name="TxtPacerState" Width="150" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPacerGap" Width="130" FontFamily="Consolas" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtPacerWatts" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Pacer strength:" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderPacerWPerKg, Path=Value, StringFormat=F1}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderPacerWPerKg" Minimum="1.5" Maximum="4.0" Value="2.5" TickFrequency="0.1" IsSnapToTickEnabled="True"
                                ValueChanged="SliderPacer_Changed"/>
                        <TextBlock Text=" W/kg (≈)" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Gap target (m):" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderPacerTarget, Path=Value, StringFormat=F0}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderPacerTarget" Minimum="10" Maximum="40" Value="25" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="SliderPacer_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Band (± m):" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderPacerBand, Path=Value, StringFormat=F0}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderPacerBand" Minimum="5" Maximum="25" Value="15" TickFrequency="1" IsSnapToTickEnabled="True"
                                ValueChanged="SliderPacer_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <TextBlock Text="Elasticity:" Width="130" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding ElementName=SliderPacerElasticity, Path=Value, StringFormat=F2}" Width="46" VerticalAlignment="Center" TextAlignment="Right"/>
                        <Slider x:Name="SliderPacerElasticity" Minimum="0.10" Maximum="0.80" Value="0.35" TickFrequency="0.05" IsSnapToTickEnabled="True"
                                ValueChanged="SliderPacer_Changed"/>
                        <TextBlock Text="  rubber band vs stick" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </DockPanel>

                    <DockPanel Margin="0,3">
                        <CheckBox x:Name="ChkPacerMercy" Content="Mercy rule" Width="130" VerticalAlignment="Center" IsChecked="True"
                                  Checked="ChkPacerMercy_Changed" Unchecked="ChkPacerMercy_Changed"/>
                        <CheckBox x:Name="ChkPacerStrip" Content="Gap strip" Width="130" VerticalAlignment="Center" IsChecked="True"
                                  Checked="ChkPacerStrip_Changed" Unchecked="ChkPacerStrip_Changed"/>
                    </DockPanel>

                    <DockPanel Margin="130,0,0,3">
                        <Button x:Name="BtnPacerReset" Content="Reset duel (level)" Width="150" Margin="0,0,6,0" Click="BtnPacerReset_Click"/>
                        <TextBlock x:Name="TxtPacerVerdict" FontFamily="Consolas" VerticalAlignment="Center"/>
                    </DockPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
